    {
      "parameters": {
        "jsCode": "// Memória que persiste entre execuções do workflow\nconst staticData = $getWorkflowStaticData('global');\nconst hooked = staticData.hooked || {};\n\nconst out = [];\nfor (const it of $input.all()) {\n  const d = it.json;\n  const uuid   = d.uuidDoc || d.uuid || '';\n  const status = (d.statusName || '').toString();\n  const cofre  = (d.safeName || '').toString();\n  if (!uuid) continue;                            // pula paginação\n  if (cofre !== 'Acme') continue;           // só contratos de cliente\n  if (/finaliz|cancel/i.test(status)) continue;   // já assinado/cancelado\n  if (hooked[uuid]) continue;                     // 🔑 já registramos antes → pula\n  hooked[uuid] = true;                            // marca como registrado\n  out.push({ json: { uuid, statusName: status, nameDoc: d.nameDoc || '' } });\n}\n\nstaticData.hooked = hooked;   // salva a memória\nreturn out;"
      },
